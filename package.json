{
  "name": "highwater-too-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Highwater Too: a VS Code replacement for Highland 2",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "tools/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w @highwater/extension",
    "pdf-compare": "node --experimental-strip-types tools/pdf-compare/src/cli.ts",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
