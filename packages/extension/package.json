{
  "name": "highwater-too",
  "displayName": "Highwater Too",
  "description": "Edit Highland 2 .highland screenplays and manuscripts in VS Code.",
  "version": "0.0.8",
  "private": true,
  "publisher": "eugenefischer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onFileSystem:highland"
  ],
  "contributes": {
    "commands": [
      {
        "command": "highwater.open",
        "title": "Open Highland Document…",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.newScreenplay",
        "title": "New Screenplay",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.newManuscript",
        "title": "New Manuscript",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.exportPdf",
        "title": "Export PDF…",
        "category": "Highwater Too",
        "icon": "$(file-pdf)"
      },
      {
        "command": "highwater.export",
        "title": "Export Text (.fountain / .md)…",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.convertToHighland",
        "title": "Save as Highland Document…",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.bold",
        "title": "Bold",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.italic",
        "title": "Italic",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.underline",
        "title": "Underline",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.strikethrough",
        "title": "Strikethrough",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.highlight",
        "title": "Highlight",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.note",
        "title": "Insert Note",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.centre",
        "title": "Centre",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.omit",
        "title": "Omit (Boneyard)",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.toggleInvisibles",
        "title": "Show Invisibles",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.hello",
        "title": "Show Version",
        "category": "Highwater Too"
      }
    ],
    "customEditors": [
      {
        "viewType": "highwater.open",
        "displayName": "Highland Document",
        "selector": [
          {
            "filenamePattern": "*.highland"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Highwater Too",
      "properties": {
        "highwater.historyFolder": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Folder for writing history and session backups. Until it is set, backups of the last 10 sessions per document go to the extension's own storage."
        },
        "highwater.highlandShortcuts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "In Highland documents, give ⌘E (Preview), ⌘L (Live Margins), ⌘0 (sidebar) and ⌘1–⌘5 (panels) their Highland meanings instead of VS Code's. Preview, Live Margins and the panels arrive in a later version; ⌘0 works now."
        }
      }
    },
    "languages": [
      {
        "id": "highland-fountain",
        "aliases": [
          "Highland Fountain",
          "fountain"
        ],
        "extensions": [
          ".fountain",
          ".spmd"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "highland-markdown",
        "aliases": [
          "Highland Markdown"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "highland-plain",
        "aliases": [
          "Highland Plain Text"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "sceneHeading",
        "description": "Scene heading"
      },
      {
        "id": "sceneNumber",
        "description": "Scene number"
      },
      {
        "id": "character",
        "description": "Character cue"
      },
      {
        "id": "parenthetical",
        "description": "Parenthetical"
      },
      {
        "id": "transition",
        "description": "Transition"
      },
      {
        "id": "centered",
        "description": "Centred or right-aligned text"
      },
      {
        "id": "lyric",
        "description": "Lyric"
      },
      {
        "id": "section",
        "description": "Section"
      },
      {
        "id": "synopsis",
        "description": "Synopsis"
      },
      {
        "id": "pageBreak",
        "description": "Page or scene break"
      },
      {
        "id": "heading",
        "description": "Heading"
      },
      {
        "id": "quote",
        "description": "Block quote"
      },
      {
        "id": "listMarker",
        "description": "List marker"
      },
      {
        "id": "term",
        "description": "Term"
      },
      {
        "id": "tableHeader",
        "description": "Table header"
      },
      {
        "id": "linkDefinition",
        "description": "Link definition"
      },
      {
        "id": "titleKey",
        "description": "Title page key"
      },
      {
        "id": "titleValue",
        "description": "Title page value"
      },
      {
        "id": "bold",
        "description": "Bold"
      },
      {
        "id": "italic",
        "description": "Italic"
      },
      {
        "id": "boldItalic",
        "description": "Bold italic"
      },
      {
        "id": "underline",
        "description": "Underline"
      },
      {
        "id": "strike",
        "description": "Strikethrough"
      },
      {
        "id": "highlight",
        "description": "Highlight"
      },
      {
        "id": "link",
        "description": "Link or image"
      },
      {
        "id": "note",
        "description": "Note"
      },
      {
        "id": "directive",
        "description": "Directive"
      },
      {
        "id": "markup",
        "description": "Markup characters"
      },
      {
        "id": "revisionTag",
        "description": "Revision tag"
      },
      {
        "id": "boneyard",
        "description": "Boneyard (omitted text)"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "highland-fountain",
        "scopes": {
          "sceneHeading": [
            "markup.heading.highland",
            "entity.name.section"
          ],
          "sceneNumber": [
            "constant.numeric"
          ],
          "character": [
            "entity.name.type",
            "entity.name.class"
          ],
          "parenthetical": [
            "variable.parameter",
            "string"
          ],
          "transition": [
            "keyword.control"
          ],
          "centered": [
            "string.quoted"
          ],
          "lyric": [
            "markup.italic"
          ],
          "section": [
            "markup.heading",
            "entity.name.section"
          ],
          "synopsis": [
            "comment.line"
          ],
          "pageBreak": [
            "meta.separator",
            "keyword.operator"
          ],
          "heading": [
            "markup.heading",
            "entity.name.section"
          ],
          "quote": [
            "markup.quote"
          ],
          "listMarker": [
            "punctuation.definition.list.begin.markdown",
            "markup.list"
          ],
          "term": [
            "markup.bold"
          ],
          "tableHeader": [
            "markup.bold"
          ],
          "linkDefinition": [
            "markup.underline.link",
            "comment"
          ],
          "titleKey": [
            "entity.other.attribute-name",
            "keyword"
          ],
          "titleValue": [
            "string"
          ],
          "bold": [
            "markup.bold"
          ],
          "italic": [
            "markup.italic"
          ],
          "boldItalic": [
            "markup.bold",
            "markup.italic"
          ],
          "underline": [
            "markup.underline"
          ],
          "strike": [
            "markup.strikethrough"
          ],
          "highlight": [
            "markup.inserted",
            "markup.highlight"
          ],
          "link": [
            "markup.underline.link"
          ],
          "note": [
            "comment.block"
          ],
          "directive": [
            "meta.preprocessor",
            "comment"
          ],
          "markup": [
            "punctuation.definition.markdown",
            "comment"
          ],
          "revisionTag": [
            "comment"
          ],
          "boneyard": [
            "comment.block"
          ]
        }
      },
      {
        "language": "highland-markdown",
        "scopes": {
          "sceneHeading": [
            "markup.heading.highland",
            "entity.name.section"
          ],
          "sceneNumber": [
            "constant.numeric"
          ],
          "character": [
            "entity.name.type",
            "entity.name.class"
          ],
          "parenthetical": [
            "variable.parameter",
            "string"
          ],
          "transition": [
            "keyword.control"
          ],
          "centered": [
            "string.quoted"
          ],
          "lyric": [
            "markup.italic"
          ],
          "section": [
            "markup.heading",
            "entity.name.section"
          ],
          "synopsis": [
            "comment.line"
          ],
          "pageBreak": [
            "meta.separator",
            "keyword.operator"
          ],
          "heading": [
            "markup.heading",
            "entity.name.section"
          ],
          "quote": [
            "markup.quote"
          ],
          "listMarker": [
            "punctuation.definition.list.begin.markdown",
            "markup.list"
          ],
          "term": [
            "markup.bold"
          ],
          "tableHeader": [
            "markup.bold"
          ],
          "linkDefinition": [
            "markup.underline.link",
            "comment"
          ],
          "titleKey": [
            "entity.other.attribute-name",
            "keyword"
          ],
          "titleValue": [
            "string"
          ],
          "bold": [
            "markup.bold"
          ],
          "italic": [
            "markup.italic"
          ],
          "boldItalic": [
            "markup.bold",
            "markup.italic"
          ],
          "underline": [
            "markup.underline"
          ],
          "strike": [
            "markup.strikethrough"
          ],
          "highlight": [
            "markup.inserted",
            "markup.highlight"
          ],
          "link": [
            "markup.underline.link"
          ],
          "note": [
            "comment.block"
          ],
          "directive": [
            "meta.preprocessor",
            "comment"
          ],
          "markup": [
            "punctuation.definition.markdown",
            "comment"
          ],
          "revisionTag": [
            "comment"
          ],
