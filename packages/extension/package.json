    "menus": {
      "commandPalette": [
        {
          "command": "highwater.export",
          "when": "resourceScheme == highland"
        },
        {
          "command": "highwater.convertToHighland",
          "when": "resourceExtname =~ /^\\.(fountain|spmd|md|markdown)$/"
        },
        {
          "command": "highwater.bold",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.italic",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.underline",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.strikethrough",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.highlight",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.note",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.centre",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.omit",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.toggleInvisibles",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.exportPdf",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.navigator.reveal",
          "when": "false"
        },
        {
          "command": "highwater.bin.open",
          "when": "false"
        },
        {
          "command": "highwater.bin.insert",
          "when": "false"
        },
        {
          "command": "highwater.bin.moveUp",
          "when": "false"
        },
        {
          "command": "highwater.bin.moveDown",
          "when": "false"
        },
        {
          "command": "highwater.bin.delete",
          "when": "false"
        },
        {
          "command": "highwater.assets.insert",
          "when": "false"
        },
        {
          "command": "highwater.assets.open",
          "when": "false"
        },
        {
          "command": "highwater.assets.delete",
          "when": "false"
        },
        {
          "command": "highwater.copyToBin",
          "when": "editorLangId =~ /^highland-/ && resourceScheme == highland"
        },
        {
          "command": "highwater.cutToBin",
          "when": "editorLangId =~ /^highland-/ && resourceScheme == highland"
        },
        {
          "command": "highwater.toggleLiveMargins",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.titlePageBuilder",
          "when": "editorLangId =~ /^highland-(fountain|markdown)$/"
        },
        {
          "command": "highwater.preview",
          "when": "editorLangId =~ /^highland-(fountain|markdown)$/"
        }
      ],
      "explorer/context": [
        {
          "command": "highwater.convertToHighland",
          "when": "resourceExtname =~ /^\\.(fountain|spmd|md|markdown)$/",
          "group": "7_modification"
        }
      ],
      "editor/title": [
        {
          "command": "highwater.preview",
          "when": "editorLangId =~ /^highland-(fountain|markdown)$/",
          "group": "navigation"
        },
        {
          "command": "highwater.exportPdf",
          "when": "editorLangId =~ /^highland-(fountain|markdown)$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "highwater.navigator.filter",
          "when": "view == highwater.navigator",
          "group": "navigation"
        },
        {
          "command": "highwater.bin.new",
          "when": "view == highwater.bin && highwater.inBundle",
          "group": "navigation@1"
        },
        {
          "command": "highwater.openScratchpad",
          "when": "view == highwater.bin && highwater.inBundle",
          "group": "navigation@2"
        },
        {
          "command": "highwater.assets.add",
          "when": "view == highwater.assets && highwater.inBundle",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "highwater.bin.insert",
          "when": "view == highwater.bin && viewItem == binItem",
          "group": "inline@1"
        },
        {
          "command": "highwater.bin.moveUp",
          "when": "view == highwater.bin && viewItem == binItem",
          "group": "1_move@1"
        },
        {
          "command": "highwater.bin.moveDown",
          "when": "view == highwater.bin && viewItem == binItem",
          "group": "1_move@2"
        },
        {
          "command": "highwater.bin.insert",
          "when": "view == highwater.bin && viewItem == binItem",
          "group": "0_use"
        },
        {
          "command": "highwater.bin.delete",
          "when": "view == highwater.bin && viewItem == binItem",
          "group": "9_delete"
        },
        {
          "command": "highwater.assets.insert",
          "when": "view == highwater.assets && viewItem == asset",
          "group": "inline@1"
        },
        {
          "command": "highwater.assets.insert",
          "when": "view == highwater.assets && viewItem == asset",
          "group": "0_use"
        },
        {
          "command": "highwater.assets.delete",
          "when": "view == highwater.assets && viewItem == asset",
          "group": "9_delete"
        }
      ],
      "editor/context": [
        {
          "command": "highwater.cutToBin",
          "when": "editorHasSelection && resourceScheme == highland && editorLangId =~ /^highland-(fountain|markdown|plain)$/",
          "group": "9_cutcopypaste@10"
        },
        {
          "command": "highwater.copyToBin",
          "when": "editorHasSelection && resourceScheme == highland && editorLangId =~ /^highland-(fountain|markdown|plain)$/",
          "group": "9_cutcopypaste@11"
        }
      ]
    },
    "keybindings": [
      {
        "command": "highwater.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.italic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.underline",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.highlight",
        "key": "ctrl+shift+=",
        "mac": "ctrl+shift+=",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.centre",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.omit",
        "mac": "cmd+y",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.note",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "editor.action.transformToUppercase",
        "mac": "ctrl+u",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "editor.action.transformToLowercase",
        "mac": "ctrl+shift+u",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "workbench.action.toggleSidebarVisibility",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "editorTextFocus && editorLangId =~ /^highland-/ && config.highwater.highlandShortcuts"
      },
      {
        "command": "highwater.cutToBin",
        "mac": "alt+cmd+x",
        "key": "ctrl+alt+x",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == highland"
      },
      {
        "command": "highwater.copyToBin",
        "mac": "alt+cmd+c",
        "key": "ctrl+alt+c",
        "when": "editorTextFocus && editorHasSelection && resourceScheme == highland"
      },
      {
        "command": "highwater.navigator.focus",
        "mac": "cmd+1",
        "key": "ctrl+1",
        "when": "editorLangId =~ /^highland-/ && config.highwater.highlandShortcuts"
      },
      {
        "command": "highwater.bin.focus",
        "mac": "cmd+2",
        "key": "ctrl+2",
        "when": "editorLangId =~ /^highland-/ && config.highwater.highlandShortcuts"
      },
      {
        "command": "highwater.assets.focus",
        "mac": "cmd+4",
        "key": "ctrl+4",
        "when": "editorLangId =~ /^highland-/ && config.highwater.highlandShortcuts"
      },
      {
        "command": "highwater.openScratchpad",
        "mac": "cmd+5",
        "key": "ctrl+5",
        "when": "editorLangId =~ /^highland-/ && config.highwater.highlandShortcuts"
      },
      {
        "command": "highwater.toggleLiveMargins",
        "mac": "cmd+l",
        "key": "ctrl+l",
        "when": "editorTextFocus && editorLangId =~ /^highland-/ && config.highwater.highlandShortcuts"
      },
      {
        "command": "highwater.toggleLiveMargins",
        "mac": "ctrl+alt+l",
        "key": "ctrl+alt+l",
        "when": "editorTextFocus && editorLangId =~ /^highland-/ && !config.highwater.highlandShortcuts"
      },
      {
        "command": "highwater.preview",
        "mac": "cmd+e",
        "key": "ctrl+e",
        "when": "editorTextFocus && editorLangId =~ /^highland-/ && config.highwater.highlandShortcuts"
      },
      {
        "command": "highwater.preview",
        "mac": "ctrl+alt+p",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus && editorLangId =~ /^highland-/ && !config.highwater.highlandShortcuts"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "highwater",
          "title": "Highwater Too",
          "icon": "media/highwater.svg"
        }
      ]
    },
    "views": {
      "highwater": [
        {
          "id": "highwater.navigator",
          "name": "Navigator",
          "icon": "media/highwater.svg"
        },
        {
          "id": "highwater.bin",
          "name": "Bin",
          "icon": "media/highwater.svg"
        },
        {
          "id": "highwater.assets",
          "name": "Assets",
          "icon": "media/highwater.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "highwater.navigator",
        "contents": "Open a Highland document, .fountain or .md file to see its scenes, sections and notes.",
        "when": "!highwater.hasDocument"
      },
      {
        "view": "highwater.bin",
        "contents": "The Bin holds text cut or copied from the script (⌥⌘X, ⌥⌘C) to use later. It is kept inside the .highland file.\n[New Bin Item](command:highwater.bin.new)\n[Open Scratchpad](command:highwater.openScratchpad)",
        "when": "highwater.inBundle"
      },
      {
        "view": "highwater.bin",
        "contents": "The Bin and Scratchpad are kept inside .highland files. Open one to use them.",
        "when": "!highwater.inBundle"
      },
      {
        "view": "highwater.assets",
        "contents": "Images kept inside this .highland file. Drag one into the text to show it in the manuscript.\n[Add Image…](command:highwater.assets.add)",
        "when": "highwater.inBundle"
      },
      {
        "view": "highwater.assets",
        "contents": "Assets are kept inside .highland files. Open one to add images.",
        "when": "!highwater.inBundle"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && vsce package --no-dependencies --skip-license --out ../../highwater-too.vsix",
    "build:e2e": "node scripts/build.mjs --e2e",
    "test:e2e": "npm run build:e2e && node --experimental-strip-types --no-warnings e2e/run.ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "pdfjs-dist": "^6.4.299"
  },
  "dependencies": {
    "@highwater/bundle": "*",
    "@highwater/parser": "*",
    "@highwater/pdf": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eugenefischer/highwater-too"
  },
  "imports": {
    "#standard-fonts/*": "./dist/standard-fonts/*.cjs"
  }
