            "comment.block"
          ]
        }
      },
      {
        "language": "highland-plain",
        "scopes": {
          "sceneHeading": [
            "markup.heading.highland",
            "entity.name.section"
          ],
          "sceneNumber": [
            "constant.numeric"
          ],
          "character": [
            "entity.name.type",
            "entity.name.class"
          ],
          "parenthetical": [
            "variable.parameter",
            "string"
          ],
          "transition": [
            "keyword.control"
          ],
          "centered": [
            "string.quoted"
          ],
          "lyric": [
            "markup.italic"
          ],
          "section": [
            "markup.heading",
            "entity.name.section"
          ],
          "synopsis": [
            "comment.line"
          ],
          "pageBreak": [
            "meta.separator",
            "keyword.operator"
          ],
          "heading": [
            "markup.heading",
            "entity.name.section"
          ],
          "quote": [
            "markup.quote"
          ],
          "listMarker": [
            "punctuation.definition.list.begin.markdown",
            "markup.list"
          ],
          "term": [
            "markup.bold"
          ],
          "tableHeader": [
            "markup.bold"
          ],
          "linkDefinition": [
            "markup.underline.link",
            "comment"
          ],
          "titleKey": [
            "entity.other.attribute-name",
            "keyword"
          ],
          "titleValue": [
            "string"
          ],
          "bold": [
            "markup.bold"
          ],
