    ],
    "configurationDefaults": {
      "[highland-fountain]": {
        "editor.wordWrap": "on",
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": false
        },
        "editor.wordBasedSuggestions": "off",
        "editor.suggestOnTriggerCharacters": false,
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "editor.renderWhitespace": "none",
        "editor.guides.indentation": false,
        "editor.stickyScroll.enabled": true
      },
      "[highland-markdown]": {
        "editor.wordWrap": "on",
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": false
        },
        "editor.wordBasedSuggestions": "off",
        "editor.suggestOnTriggerCharacters": false,
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "editor.renderWhitespace": "none",
        "editor.guides.indentation": false,
        "editor.stickyScroll.enabled": true
      },
      "[highland-plain]": {
        "editor.wordWrap": "on",
        "editor.semanticHighlighting.enabled": true,
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": false
        },
        "editor.wordBasedSuggestions": "off",
        "editor.suggestOnTriggerCharacters": false,
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false,
        "editor.renderWhitespace": "none",
        "editor.guides.indentation": false,
        "editor.stickyScroll.enabled": true
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "highwater.export",
          "when": "resourceScheme == highland"
        },
        {
          "command": "highwater.convertToHighland",
          "when": "resourceExtname =~ /^\\.(fountain|spmd|md|markdown)$/"
        },
        {
          "command": "highwater.bold",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.italic",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.underline",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.strikethrough",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.highlight",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.note",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.centre",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.omit",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.toggleInvisibles",
          "when": "editorLangId =~ /^highland-/"
        },
        {
          "command": "highwater.exportPdf",
          "when": "editorLangId =~ /^highland-/"
        }
      ],
      "explorer/context": [
        {
          "command": "highwater.convertToHighland",
          "when": "resourceExtname =~ /^\\.(fountain|spmd|md|markdown)$/",
          "group": "7_modification"
        }
      ],
      "editor/title": [
        {
          "command": "highwater.exportPdf",
          "when": "editorLangId =~ /^highland-(fountain|markdown)$/",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "highwater.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.italic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.underline",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.highlight",
        "key": "ctrl+shift+=",
        "mac": "ctrl+shift+=",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.centre",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.omit",
        "mac": "cmd+y",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "highwater.note",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "editor.action.transformToUppercase",
        "mac": "ctrl+u",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "editor.action.transformToLowercase",
        "mac": "ctrl+shift+u",
        "when": "editorTextFocus && editorLangId =~ /^highland-/"
      },
      {
        "command": "workbench.action.toggleSidebarVisibility",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "editorTextFocus && editorLangId =~ /^highland-/ && config.highwater.highlandShortcuts"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "npm run build && vsce package --no-dependencies --skip-license --out ../../highwater-too.vsix",
    "build:e2e": "node scripts/build.mjs --e2e",
    "test:e2e": "npm run build:e2e && node --experimental-strip-types --no-warnings e2e/run.ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0"
  },
  "dependencies": {
    "@highwater/bundle": "*",
    "@highwater/parser": "*",
    "@highwater/pdf": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eugenefischer/highwater-too"
  },
  "imports": {
    "#standard-fonts/*": "./dist/standard-fonts/*.cjs"
  }
}
