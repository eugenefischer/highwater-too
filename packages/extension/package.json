{
  "name": "highwater-too",
  "displayName": "Highwater Too",
  "description": "Edit Highland 2 .highland screenplays and manuscripts in VS Code.",
  "version": "0.0.13",
  "private": true,
  "publisher": "eugenefischer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onFileSystem:highland"
  ],
  "contributes": {
    "commands": [
      {
        "command": "highwater.open",
        "title": "Open Highland Document…",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.newScreenplay",
        "title": "New Screenplay",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.newManuscript",
        "title": "New Manuscript",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.exportPdf",
        "title": "Export PDF…",
        "category": "Highwater Too",
        "icon": "$(file-pdf)"
      },
      {
        "command": "highwater.export",
        "title": "Export Text (.fountain / .md)…",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.convertToHighland",
        "title": "Save as Highland Document…",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.bold",
        "title": "Bold",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.italic",
        "title": "Italic",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.underline",
        "title": "Underline",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.strikethrough",
        "title": "Strikethrough",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.highlight",
        "title": "Highlight",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.note",
        "title": "Insert Note",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.centre",
        "title": "Centre",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.omit",
        "title": "Omit (Boneyard)",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.toggleInvisibles",
        "title": "Show Invisibles",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.hello",
        "title": "Show Version",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.navigator.filter",
        "title": "Show or Hide Item Types…",
        "category": "Highwater Too",
        "icon": "$(filter)"
      },
      {
        "command": "highwater.navigator.reveal",
        "title": "Go to Item",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.copyToBin",
        "title": "Copy to Bin",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.cutToBin",
        "title": "Cut to Bin",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.bin.new",
        "title": "New Bin Item",
        "category": "Highwater Too",
        "icon": "$(add)"
      },
      {
        "command": "highwater.bin.open",
        "title": "Open Bin Item",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.bin.insert",
        "title": "Insert into Script",
        "category": "Highwater Too",
        "icon": "$(insert)"
      },
      {
        "command": "highwater.bin.moveUp",
        "title": "Move Up",
        "category": "Highwater Too",
        "icon": "$(arrow-up)"
      },
      {
        "command": "highwater.bin.moveDown",
        "title": "Move Down",
        "category": "Highwater Too",
        "icon": "$(arrow-down)"
      },
      {
        "command": "highwater.bin.delete",
        "title": "Delete",
        "category": "Highwater Too",
        "icon": "$(trash)"
      },
      {
        "command": "highwater.assets.add",
        "title": "Add Image…",
        "category": "Highwater Too",
        "icon": "$(add)"
      },
      {
        "command": "highwater.assets.insert",
        "title": "Insert into Script",
        "category": "Highwater Too",
        "icon": "$(insert)"
      },
      {
        "command": "highwater.assets.open",
        "title": "Open Image",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.assets.delete",
        "title": "Delete",
        "category": "Highwater Too",
        "icon": "$(trash)"
      },
      {
        "command": "highwater.openScratchpad",
        "title": "Open Scratchpad",
        "category": "Highwater Too",
        "icon": "$(notebook)"
      },
      {
        "command": "highwater.toggleLiveMargins",
        "title": "Toggle Live Margins",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.titlePageBuilder",
        "title": "Title Page Builder…",
        "category": "Highwater Too"
      },
      {
        "command": "highwater.preview",
        "title": "Preview",
        "category": "Highwater Too",
        "icon": "$(open-preview)"
      }
    ],
    "customEditors": [
      {
        "viewType": "highwater.open",
        "displayName": "Highland Document",
        "selector": [
          {
            "filenamePattern": "*.highland"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Highwater Too",
      "properties": {
        "highwater.historyFolder": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Folder for writing history and session backups. Until it is set, backups of the last 10 sessions per document go to the extension's own storage."
        },
        "highwater.highlandShortcuts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "In Highland documents, give ⌘E (Preview), ⌘L (Live Margins), ⌘0 (sidebar), ⌘1 (Navigator), ⌘2 (Bin), ⌘4 (Assets) and ⌘5 (Scratchpad) their Highland meanings instead of VS Code's. With it off, Preview is ⌃⌥P and Live Margins ⌃⌥L."
        },
        "highwater.showSidebarOnOpen": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Switch the sidebar to Highwater Too (Navigator, Bin, Assets) when a Highland script is opened."
        }
      }
    },
    "languages": [
      {
        "id": "highland-fountain",
        "aliases": [
          "Highland Fountain",
          "fountain"
        ],
        "extensions": [
          ".fountain",
          ".spmd"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "highland-markdown",
        "aliases": [
          "Highland Markdown"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "highland-plain",
        "aliases": [
          "Highland Plain Text"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
