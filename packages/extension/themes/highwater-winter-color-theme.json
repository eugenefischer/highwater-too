{
  "$schema": "vscode://schemas/color-theme",
  "name": "Highwater Winter",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#3a3a3a",
    "descriptionForeground": "#696969",
    "focusBorder": "#326878",
    "textLink.foreground": "#326878",
    "textLink.activeForeground": "#326878",
    "progressBar.background": "#326878",
    "badge.background": "#326878",
    "badge.foreground": "#ffffff",
    "button.background": "#326878",
    "button.foreground": "#ffffff",
    "button.hoverBackground": "#2c5c6a",
    "input.background": "#f4f4f4",
    "input.foreground": "#3a3a3a",
    "input.border": "#cfcfcf",
    "input.placeholderForeground": "#696969",
    "dropdown.background": "#f4f4f4",
    "dropdown.foreground": "#3a3a3a",
    "dropdown.border": "#cfcfcf",
    "scrollbarSlider.background": "#69696940",
    "scrollbarSlider.hoverBackground": "#69696966",
    "scrollbarSlider.activeBackground": "#6969698c",
    "widget.shadow": "#00000033",
    "editor.background": "#f5f5f5",
    "editor.foreground": "#333333",
    "editorCursor.foreground": "#d36671",
    "editor.selectionBackground": "#3268784d",
    "editor.inactiveSelectionBackground": "#3268782e",
    "editor.selectionHighlightBackground": "#32687826",
    "editor.findMatchBackground": "#32687899",
    "editor.findMatchHighlightBackground": "#3268784d",
    "editor.lineHighlightBackground": "#3333330a",
    "editor.lineHighlightBorder": "#00000000",
    "editorLineNumber.foreground": "#69696999",
    "editorLineNumber.activeForeground": "#696969",
    "editorWhitespace.foreground": "#69696999",
    "editorIndentGuide.background1": "#69696926",
    "editorInlayHint.foreground": "#696969",
    "editorInlayHint.background": "#00000000",
    "editorGutter.background": "#f5f5f5",
    "editorWidget.background": "#e3e3e3",
    "editorWidget.foreground": "#3a3a3a",
    "editorWidget.border": "#cfcfcf",
    "editorSuggestWidget.background": "#e3e3e3",
    "editorSuggestWidget.foreground": "#3a3a3a",
    "editorSuggestWidget.border": "#cfcfcf",
    "editorSuggestWidget.selectedBackground": "#32687859",
    "editorSuggestWidget.highlightForeground": "#326878",
    "editorHoverWidget.background": "#e3e3e3",
    "editorHoverWidget.foreground": "#3a3a3a",
    "editorHoverWidget.border": "#cfcfcf",
    "editorGroupHeader.tabsBackground": "#e3e3e3",
    "editorGroupHeader.tabsBorder": "#e3e3e3",
    "editorGroup.border": "#cfcfcf",
    "tab.activeBackground": "#f5f5f5",
    "tab.activeForeground": "#333333",
    "tab.activeBorderTop": "#326878",
    "tab.inactiveBackground": "#e3e3e3",
    "tab.inactiveForeground": "#3a3a3ab3",
    "tab.border": "#e3e3e3",
    "breadcrumb.background": "#f5f5f5",
    "breadcrumb.foreground": "#696969",
    "sideBar.background": "#e3e3e3",
    "sideBar.foreground": "#3a3a3a",
    "sideBar.border": "#e3e3e3",
    "sideBarTitle.foreground": "#3a3a3a",
    "sideBarSectionHeader.background": "#e3e3e3",
    "sideBarSectionHeader.foreground": "#3a3a3a",
    "sideBarSectionHeader.border": "#cfcfcf",
    "list.activeSelectionBackground": "#32687866",
    "list.activeSelectionForeground": "#3a3a3a",
    "list.inactiveSelectionBackground": "#32687840",
    "list.inactiveSelectionForeground": "#3a3a3a",
    "list.hoverBackground": "#3a3a3a14",
    "list.hoverForeground": "#3a3a3a",
    "list.focusOutline": "#326878",
    "list.highlightForeground": "#326878",
    "list.dropBackground": "#32687840",
    "tree.indentGuidesStroke": "#6969694d",
    "activityBar.background": "#e3e3e3",
    "activityBar.foreground": "#3a3a3a",
    "activityBar.inactiveForeground": "#3a3a3a80",
    "activityBar.activeBorder": "#326878",
    "activityBar.border": "#e3e3e3",
    "activityBarBadge.background": "#326878",
    "activityBarBadge.foreground": "#ffffff",
    "titleBar.activeBackground": "#e3e3e3",
    "titleBar.activeForeground": "#3a3a3a",
    "titleBar.inactiveBackground": "#e3e3e3",
    "titleBar.inactiveForeground": "#696969",
    "titleBar.border": "#e3e3e3",
    "statusBar.background": "#e3e3e3",
    "statusBar.foreground": "#3a3a3a",
    "statusBar.border": "#e3e3e3",
    "statusBar.noFolderBackground": "#e3e3e3",
    "statusBar.debuggingBackground": "#326878",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBarItem.remoteBackground": "#326878",
    "statusBarItem.remoteForeground": "#ffffff",
    "statusBarItem.hoverBackground": "#3a3a3a1f",
    "panel.background": "#f5f5f5",
    "panel.border": "#cfcfcf",
    "panelTitle.activeForeground": "#333333",
    "panelTitle.activeBorder": "#326878",
    "panelTitle.inactiveForeground": "#696969",
    "terminal.background": "#f5f5f5",
    "terminal.foreground": "#333333",
    "quickInput.background": "#e3e3e3",
    "quickInput.foreground": "#3a3a3a",
    "quickInputList.focusBackground": "#32687866",
    "quickInputList.focusForeground": "#3a3a3a",
    "pickerGroup.foreground": "#326878",
    "menu.background": "#e3e3e3",
    "menu.foreground": "#3a3a3a",
    "menu.selectionBackground": "#32687866",
    "menu.selectionForeground": "#3a3a3a",
    "menu.border": "#cfcfcf",
    "notifications.background": "#e3e3e3",
    "notifications.foreground": "#3a3a3a",
    "toolbar.hoverBackground": "#3a3a3a1f"
  },
  "semanticTokenColors": {
    "sceneHeading": {
      "foreground": "#84697c",
      "bold": true
    },
    "sceneNumber": "#84697c",
    "section": "#696969",
    "synopsis": "#696969",
    "heading": {
      "foreground": "#333333",
      "bold": true
    },
    "note": {
      "foreground": "#5e4630",
      "italic": true
    },
    "directive": "#696969",
    "markup": "#696969",
    "revisionTag": "#696969",
    "boneyard": "#696969",
    "titleKey": "#696969",
    "titleValue": "#333333",
    "character": "#333333",
    "parenthetical": "#333333",
    "transition": "#333333",
    "centered": "#333333",
    "lyric": {
      "foreground": "#333333",
      "italic": true
    },
    "pageBreak": "#696969",
    "quote": {
      "foreground": "#333333",
      "italic": true
    },
    "listMarker": "#696969",
    "term": {
      "foreground": "#333333",
      "bold": true
    },
    "tableHeader": {
      "foreground": "#333333",
      "bold": true
    },
    "linkDefinition": "#696969",
    "link": {
      "foreground": "#326878",
      "underline": true
    },
    "bold": {
      "bold": true
    },
    "italic": {
      "italic": true
    },
    "boldItalic": {
      "bold": true,
      "italic": true
    },
    "underline": {
      "underline": true
    },
    "strike": {
      "strikethrough": true
    },
    "highlight": {
      "foreground": "#333333"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#696969",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#84697c",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#5795a0"
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#326878"
      }
    },
    {
      "scope": [
        "constant",
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#5795a0"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#326878"
      }
    }
  ]
}
